generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//

model User {
  id            String   @id @default(ulid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions  Session[]
  accounts  Account[]
  favorites Favorite[]
  reaction  PostReaction[]

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

//

model TelegramPost {
  id Int @id @default(autoincrement())

  textCaption  String?  @map("text_caption")
  textEntities Json?    @map("text_entities")
  cryptoTokens String[] @map("crypto_tokens")

  tgAuthorTitle    String @map("tg_author_title")
  tgAuthorUsername String @map("tg_author_username")
  tgAuthorId       String @map("tg_author_id")

  mediaGroupId String? @map("media_group_id")
  media        Json?

  likeCount      Int @default(0) @map("like_count")
  dislikeCount   Int @default(0) @map("dislike_count")
  favoritesCount Int @default(0) @map("favorites_count")
  commentsCount  Int @default(0) @map("comments_count")

  createdAt DateTime @default(now()) @map("created_at")

  favorites Favorite[]
  reaction  PostReaction[]

  @@map("telegram_posts")
}

//

model Favorite {
  id Int @id @default(autoincrement())

  userId String @map("user_id")
  postId Int    @map("post_id")

  user User         @relation(fields: [userId], references: [id])
  post TelegramPost @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, postId])
  @@map("favorites")
}

//

model PostReaction {
  id Int @id @default(autoincrement())

  userId String @map("user_id")
  postId Int    @map("post_id")

  user User         @relation(fields: [userId], references: [id])
  post TelegramPost @relation(fields: [postId], references: [id])

  reactionType ReactionType @map("reaction_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, postId])
  @@map("post_reactions")
}

enum ReactionType {
  LIKE
  DISLIKE
}

model UserCard {
  id        String   @id @default(ulid())
  name      String
  cardName  String   @map("card_name") @db.VarChar(20)
  pin       String
  amount    Int
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([id, pin])
  @@map("user_card")
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(false)

  @@index([secret])
  @@index([userId])
  @@map("twoFactor")
}
