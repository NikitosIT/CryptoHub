generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//

model User {
  id            String   @id @default(ulid())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  sessions  Session[]
  accounts  Account[]
  favorites PostFavorite[]
  reaction  PostReaction[]

  twoFactorEnabled Boolean?    @default(false)
  twofactors       TwoFactor[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @map("expires_at")
  token     String   @unique
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  userId    String   @map("user_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  userId                String    @map("user_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String    @id
  identifier String
  value      String
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime? @default(now()) @map("created_at")
  updatedAt  DateTime? @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

//

model TelegramPost {
  id Int @id @default(autoincrement())

  textCaption  String?  @map("text_caption")
  textEntities Json?    @map("text_entities")
  cryptoTokens String[] @map("crypto_tokens")

  tgAuthorTitle    String @map("tg_author_title")
  tgAuthorUsername String @map("tg_author_username")
  tgAuthorId       String @map("tg_author_id")

  mediaGroupId String? @map("media_group_id")
  media        Json?

  likeCount      Int @default(0) @map("like_count")
  dislikeCount   Int @default(0) @map("dislike_count")
  favoritesCount Int @default(0) @map("favorites_count")
  commentsCount  Int @default(0) @map("comments_count")

  createdAt DateTime @default(now()) @map("created_at")

  favorites PostFavorite[]
  reaction  PostReaction[]

  @@map("telegram_posts")
}

//

model PostFavorite {
  id Int @id @default(autoincrement())

  userId String @map("user_id")
  postId Int    @map("post_id")

  user User         @relation(fields: [userId], references: [id])
  post TelegramPost @relation(fields: [postId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, postId])
  @@map("post_favorites")
}

//

model PostReaction {
  id Int @id @default(autoincrement())

  userId String @map("user_id")
  postId Int    @map("post_id")

  user User         @relation(fields: [userId], references: [id])
  post TelegramPost @relation(fields: [postId], references: [id])

  reactionType PostReactionType @map("reaction_type")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([userId, postId])
  @@map("post_reactions")
}

enum PostReactionType {
  LIKE
  DISLIKE
}

model TwoFactor {
  id          String   @id
  secret      String
  backupCodes String
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  verified    Boolean? @default(false)

  @@index([secret])
  @@index([userId])
  @@map("two_factor")
}

model CryptotokenSnapshot {
  id Int @id @default(autoincrement())

  coinGeckoId String @map("coingecko_id")
  symbol      String
  name        String
  image       String

  currentPrice              Decimal  @map("current_price") @db.Decimal(20, 8)
  marketCap                 BigInt   @map("market_cap")
  marketCapRank             Int?     @map("market_cap_rank")
  totalVolume               BigInt   @map("total_volume")
  high24h                   Decimal? @map("high_24h") @db.Decimal(20, 8)
  low24h                    Decimal? @map("low_24h") @db.Decimal(20, 8)
  priceChange24h            Decimal? @map("price_change_24h") @db.Decimal(20, 8)
  priceChangePercentage24h  Decimal? @map("price_change_percentage_24h") @db.Decimal(20, 8)
  marketCapChange24h        Decimal? @map("market_cap_change_24h") @db.Decimal(20, 8)
  marketCapChangePercentage Decimal? @map("market_cap_change_percentage_24h") @db.Decimal(20, 8)
  ath                       Decimal  @db.Decimal(20, 8)
  athChangePercentage       Decimal? @map("ath_change_percentage") @db.Decimal(20, 8)
  athDate                   DateTime @map("ath_date")
  atl                       Decimal  @db.Decimal(20, 8)
  atlChangePercentage       Decimal? @map("atl_change_percentage") @db.Decimal(20, 8)
  atlDate                   DateTime @map("atl_date")
  lastUpdated               DateTime @map("last_updated")

  snapshotAt DateTime @default(now()) @map("snapshot_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("cryptotoken_snapshots")
}
