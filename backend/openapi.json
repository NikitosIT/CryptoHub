    "/crypto-ai/chat/stream": {
      "post": {
        "tags": [
          "Crypto AI"
        ],
        "summary": "Start AI crypto chat stream",
        "description": "Creates a new AI-powered crypto chat and streams the response via SSE (Server-Sent Events).\n\nThe response is a stream of JSON events:\n- `{\"type\":\"init\",\"chatId\":\"...\"}` — emitted first with the chat record ID\n- `{\"type\":\"chunk\",\"content\":\"...\"}` — partial text chunks from the AI\n- `{\"type\":\"done\"}` — generation completed successfully\n- `{\"type\":\"error\",\"message\":\"...\"}` — an error occurred\n\nUsers are limited to 3 requests per day. If the client disconnects mid-stream, the partial response is saved with status ABORTED and still counts toward the limit.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Bearer token returned by the sign-in endpoint.",
              "example": "Bearer your-auth-token"
            },
            "required": true,
            "description": "Bearer token returned by the sign-in endpoint.",
            "name": "authorization",
            "in": "header"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CryptoAiChatStreamRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SSE stream of AI-generated content.",
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            }
          },
          "400": {
            "description": "Request body validation failed."
          },
          "401": {
            "description": "Authentication is required."
          },
          "429": {
            "description": "Daily request limit reached."
          }
        }
      }
    },
    "/crypto-ai/chat/{id}": {
      "get": {
        "tags": [
          "Crypto AI"
        ],
        "summary": "Get completed chat by ID",
        "description": "Returns a single chat record by its ID. Only chats with status COMPLETED are returned.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Chat record ID"
            },
            "required": true,
